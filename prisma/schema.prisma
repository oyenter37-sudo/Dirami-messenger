generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String     @id @default(cuid())
  nickname          String     @unique
  displayName       String     @default("")
  passwordHash      String
  isAdmin           Boolean    @default(false)
  sessionVersion    Int        @default(0)
  bio               String     @default("")
  avatarUrl         String     @default("")
  profileAccent     String     @default("#4fbfa8")
  profileBackground String     @default("aurora")
  createdAt         DateTime   @default(now())
  sentMessages      Message[]  @relation("SentMessages")
  receivedMessages  Message[]  @relation("ReceivedMessages")
  reactions         Reaction[]
  nfts              Nft[]
  chatsAsA          Chat[]     @relation("ChatUserA")
  chatsAsB          Chat[]     @relation("ChatUserB")
  initiatedChats    Chat[]     @relation("ChatInitiator")
  authoredNews      News[]     @relation("NewsAuthor")
  newsReads         NewsRead[]
  limits            UserLimit?
}

model News {
  id        String     @id @default(cuid())
  title     String
  content   String
  createdAt DateTime   @default(now())
  authorId  String
  author    User       @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reads     NewsRead[]

  @@index([createdAt])
}

model NewsRead {
  userId String
  newsId String
  readAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  news   News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@id([userId, newsId])
  @@index([newsId])
}

model UserLimit {
  userId                  String   @id
  messagesPerMinute       Int      @default(12)
  pendingRequests         Int      @default(3)
  chatRequestsPerHour     Int      @default(10)
  requestActionsPerMinute Int      @default(30)
  reactionsPerMinute      Int      @default(30)
  chatListReadsPerMinute  Int      @default(40)
  messageReadsPerMinute   Int      @default(90)
  searchesPerMinute       Int      @default(30)
  profileViewsPerMinute   Int      @default(60)
  profileUpdatesPerHour   Int      @default(12)
  passwordChangesPerHour  Int      @default(5)
  nftTransfersPerHour     Int      @default(20)
  nftMintsPerHour         Int      @default(100)
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RateLimitBucket {
  id          String   @id
  subject     String
  action      String
  windowStart DateTime
  expiresAt   DateTime
  count       Int      @default(1)

  @@index([expiresAt])
  @@index([subject, action, windowStart])
}

enum ChatStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Chat {
  id          String     @id @default(cuid())
  userAId     String
  userBId     String
  initiatorId String
  status      ChatStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userA       User       @relation("ChatUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User       @relation("ChatUserB", fields: [userBId], references: [id], onDelete: Cascade)
  initiator   User       @relation("ChatInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId, status, updatedAt])
  @@index([userBId, status, updatedAt])
  @@index([initiatorId, status])
}

model Message {
  id         String     @id @default(cuid())
  content    String
  createdAt  DateTime   @default(now())
  readAt     DateTime?
  senderId   String
  receiverId String
  replyToId  String?
  sender     User       @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User       @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  replyTo    Message?   @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    Message[]  @relation("MessageReplies")
  reactions  Reaction[]

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, readAt])
  @@index([replyToId])
}

model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  createdAt DateTime @default(now())
  userId    String
  messageId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([messageId])
}

model Nft {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String
  valueRub  Int
  createdAt DateTime @default(now())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}
